<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fuhouyu.sass.platform.system.mapper.TenantSpaceMapper">
    <resultMap id="BaseResultMap" type="com.fuhouyu.sass.platform.system.domain.entity.TenantSpace" extends="com.fuhouyu.sass.platform.system.mapper.BaseEntityMapper.BaseResultMap">
        <result column="tenant_id" property="tenantId"/>
        <result column="bucket_name" property="bucketName"/>
        <result column="capacity" property="capacity"/>
        <result column="acl" property="acl"/>
    </resultMap>

    <resultMap id="BaseResultDetailMap" type="com.fuhouyu.sass.platform.system.domain.dto.tenant.TenantSpaceDetailDTO" extends="BaseResultMap">
        <result column="usedCapacity" property="usedCapacity"/>
    </resultMap>
    <sql id="TableName">
        tenant_space
    </sql>

    <sql id="InsertColumns">
        tenant_id,
        bucket_name,
        capacity,
        acl,
        created_at,
        updated_at,
        created_by,
        updated_by
    </sql>


    <sql id="QueryColumns">
        ts.tenant_id,
        ts.bucket_name,
        ts.capacity,
        ts.acl,
        ts.created_at,
        ts.updated_at,
        ts.created_by,
        ts.updated_by
    </sql>

    <insert id="insert" parameterType="com.fuhouyu.sass.platform.system.domain.entity.Resources">
        INSERT INTO
        <include refid="TableName"/>
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <include refid="InsertColumns"/>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            #{tenantId},
            #{bucketName},
            #{capacity},
            #{acl},
            #{createdAt},
            #{updatedAt},
            #{createdBy},
            #{updatedBy}
        </trim>
    </insert>

    <update id="update" parameterType="com.fuhouyu.sass.platform.system.domain.entity.Resources">
        UPDATE
        <include refid="TableName"/>
        SET
        <if test="bucketName != null and bucketName != ''">
            bucket_name = #{bucketName},
        </if>
        <if test="capacity != null">
            capacity = #{capacity},
        </if>
        <if test="acl != null and acl != ''">
            acl = #{acl},
        </if>
        updated_at = #{updatedAt},
        updated_by = #{updatedBy}
        WHERE tenant_id = #{tenantId}
    </update>


    <select id="countTenantSpaceByName" resultType="int">
        SELECT COUNT(1) FROM <include refid="TableName"/>
        WHERE bucket_name = #{spaceName}
    </select>

    <select id="queryDetailById" resultMap="BaseResultDetailMap">
        SELECT
        <include refid="QueryColumns"/>,
        sum(r.size) as usedCapacity
        FROM
        <include refid="TableName"/> ts
        LEFT JOIN resources r ON ts.tenant_id = r.owner_tenant_id
        WHERE tenant_id = #{tenantId}
        GROUP BY
        <include refid="QueryColumns"/>

    </select>
</mapper>
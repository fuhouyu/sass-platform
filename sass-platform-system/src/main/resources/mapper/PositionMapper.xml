<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/did/mybatis-3-mapper.dtd">
<mapper namespace="com.fuhouyu.sass.platform.system.mapper.PositionMapper">
    <resultMap id="BaseResultMap" type="com.fuhouyu.sass.platform.system.entity.Positions" extends="com.fuhouyu.sass.platform.system.mapper.BaseMapper.BaseResultMap">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="position_name" property="positionName" jdbcType="VARCHAR"/>
        <result column="position_code" property="positionCode" jdbcType="VARCHAR"/>
        <result column="remark" property="remark" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="TableName">
        positions
    </sql>

    <sql id="AllColumns" >
        id,
        position_name,
        position_code,
        remark,
        owner_tenant_id,
        is_deleted,
        create_at, 
        create_by, 
        update_at, 
        update_by
    </sql>

    <sql id="QueryColumns" >
        p.id,
        p.position_name,
        p.position_code,
        p.remark,
        p.owner_tenant_id,
        p.is_deleted,
        p.create_at,
        p.create_by,
        p.update_at,
        p.update_by
    </sql>

    <insert id="insert" parameterType="com.fuhouyu.sass.platform.system.entity.Positions">
        INSERT INTO
        <include refid="TableName"/>
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <include refid="AllColumns"/>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            #{id},
            #{positionName},
            #{positionCode},
            #{remark},
            #{ownerTenantId},
            #{isDeleted},
            #{createAt},
            #{createBy},
            #{updateAt},
            #{updateBy},
        </trim>
    </insert>

    <insert id="insertBatch" parameterType="java.util.List" >
        INSERT INTO
        <include refid="TableName"/>
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <include refid="AllColumns"/>
        </trim>
        VALUES
        <foreach collection="list" separator="," item="entity">
            <trim prefix="(" suffix=")" suffixOverrides=",">
                #{entity.id},
                #{entity.positionName},
                #{entity.positionCode},
                #{entity.remark},
                #{entity.ownerTenantId},
                #{entity.isDeleted},
                #{entity.createAt},
                #{entity.createBy},
                #{entity.updateAt},
                #{entity.updateBy},
            </trim>
        </foreach>
    </insert>

    <update id="update" parameterType="com.fuhouyu.sass.platform.system.entity.Positions">
        UPDATE
        <include refid="TableName"/>
        SET
        <if test="positionName != null and positionName != ''">
            position_name = #{positionName},
        </if>
        <if test="remark != null ">
            remark = #{remark},
        </if>
        update_at = #{updateAt},
        update_by = #{updateBy}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM <include refid="TableName"/>
        WHERE id = #{id}
    </delete>

    <delete id="deleteByIds" parameterType="java.util.List">
        DELETE FROM <include refid="TableName"/>
        WHERE id IN
        <foreach collection="list" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
    </delete>

    <select id="queryById" resultMap="BaseResultMap">
        SELECT <include refid="QueryColumns"/>
        FROM <include refid="TableName"/> p
        WHERE p.id = #{id}
        AND p.is_deleted = false
    </select>


    <select id="queryByIds" parameterType="java.util.List" resultMap="BaseResultMap">
        SELECT <include refid="QueryColumns"/>
        FROM <include refid="TableName"/> p
        WHERE p.id IN
        <foreach collection="list" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
        AND p.is_deleted = false
    </select>

    <select id="queryList" resultMap="BaseResultMap" >
        SELECT
        <include refid="QueryColumns"/>
                FROM
        <include refid="TableName"/> p
        <where>
            <if test="pageQuery.positionName != null and pageQuery.positionName != ''">
                p.position_name LIKE CONCAT('%', #{pageQuery.positionName}, '%')
            </if>
            <if test="pageQuery.positionCode != null and pageQuery.positionCode != ''">
                AND p.position_code = #{pageQuery.positionCode}
            </if>
            AND p.is_deleted = false
        </where>
    </select>

    <select id="queryPositionByPositionCode" resultMap="BaseResultMap">
        SELECT
        <include refid="QueryColumns"/>
        FROM
        <include refid="TableName"/> p
        WHERE p.position_code = #{positionCode}
    </select>
</mapper>
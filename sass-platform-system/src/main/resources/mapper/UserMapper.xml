<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fuhouyu.sass.platform.system.mapper.UserMapper">
    <resultMap id="BaseResultMap" type="com.fuhouyu.sass.platform.system.entity.Users" extends="com.fuhouyu.sass.platform.system.mapper.BaseMapper.BaseResultMap">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="username" property="username" jdbcType="VARCHAR"/>
        <result column="real_name" property="realName" jdbcType="VARCHAR"/>
        <result column="nickname" property="nickname" jdbcType="VARCHAR"/>
        <result column="email" property="email" jdbcType="VARCHAR"/>
        <result column="gender" property="gender" jdbcType="VARCHAR"/>
        <result column="avatar" property="avatar" jdbcType="VARCHAR"/>
        <result column="login_date" property="loginDate" jdbcType="TIMESTAMP"/>
        <result column="login_ip" property="loginIp" jdbcType="VARCHAR"/>
    </resultMap>

    <resultMap id="UserDetailResultMap" type="com.fuhouyu.sass.platform.system.dto.user.UserDetailDTO" extends="BaseResultMap">
        <association property="userPosition" resultMap="com.fuhouyu.sass.platform.system.mapper.UserPositionMapper.UserPositionDetailResultMap"/>
    </resultMap>

    <sql id="TableName">
        users
    </sql>

    <sql id="InsertColumns">
        id,
        username,
        real_name,
        nickname,
        email,
        gender,
        avatar,
        login_date,
        login_ip,
        is_deleted,
        create_at,
        update_at,
        create_by,
        update_by
    </sql>

    <sql id="QueryAllColumns">
        u.id,
        u.username,
        u.real_name,
        u.nickname,
        u.email,
        u.gender,
        u.avatar,
        u.login_date,
        u.login_ip,
        u.create_at,
        u.update_at,
        u.create_by,
        u.update_by
    </sql>

    <insert id="insert" parameterType="com.fuhouyu.sass.platform.system.entity.Users">
        INSERT INTO
        <include refid="TableName"/>
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <include refid="InsertColumns"/>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            #{id},
            #{username},
            #{realName},
            #{nickname},
            #{email},
            #{gender},
            #{avatar},
            #{loginDate},
            #{loginIp},
            #{isDeleted},
            #{createAt},
            #{updateAt},
            #{createBy},
            #{updateBy}
        </trim>
    </insert>

    <insert id="insertBatch" parameterType="java.util.List" >
        INSERT INTO
        <include refid="TableName"/>
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <include refid="InsertColumns"/>
        </trim>
        VALUES
        <foreach collection="list" separator="," item="entity">
            <trim prefix="(" suffix=")" suffixOverrides=",">
                #{entity.id},
                #{entity.username},
                #{entity.realName},
                #{entity.nickname},
                #{entity.email},
                #{entity.gender},
                #{entity.avatar},
                #{entity.loginDate},
                #{entity.loginIp},
                #{entity.isDeleted},
                #{entity.createAt},
                #{entity.updateAt},
                #{entity.createBy},
                #{entity.updateBy}
            </trim>
        </foreach>
    </insert>

    <update id="update" parameterType="com.fuhouyu.sass.platform.system.entity.Users">
        UPDATE
        <include refid="TableName"/>
        SET
        <if test="avatar != null">
            avatar = #{avatar},
        </if>
        <if test="realName != null and realName != ''">
            real_name = #{realName},
        </if>
        <if test="nickname != null and nickname != ''">
            nickname = #{nickname},
        </if>
        <if test="email != null and email != ''">
            email = #{email},
        </if>
        <if test="gender != null and gender != ''">
            gender = #{gender},
        </if>
         <if test="loginDate != null ">
            login_date = #{loginDate},
        </if>
        <if test="loginIp != null and loginIp != ''">
            login_ip = #{loginIp},
        </if>
        update_at = #{updateAt},
        update_by = #{updateBy}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM <include refid="TableName"/>
        WHERE id = #{id}
    </delete>

    <delete id="deleteByIds" parameterType="java.util.List">
        DELETE FROM <include refid="TableName"/>
        WHERE id IN
        <foreach collection="list" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
    </delete>

    <select id="queryById" resultMap="BaseResultMap">
        SELECT <include refid="QueryAllColumns"/>
        FROM <include refid="TableName"/> u
        WHERE u.id = #{id}
    </select>


    <select id="queryByIds" parameterType="java.util.List" resultMap="BaseResultMap">
        SELECT <include refid="QueryAllColumns"/>
        FROM <include refid="TableName"/> u
        WHERE u.id IN
        <foreach collection="list" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
    </select>


    <select id="queryByUsername" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT <include refid="QueryAllColumns"/>
        FROM <include refid="TableName"/> u
        WHERE u.username = #{username}
    </select>

    <select id="queryList" resultMap="BaseResultMap" >
        SELECT
        <include refid="QueryAllColumns"/>
        FROM
        <include refid="TableName"/>  u LEFT JOIN
        user_positions up ON u.id = up.user_id
        <where>
            up.organization_id = #{pageQuery.organizationId}
            <if test="pageQuery.username != null and pageQuery.username != ''">
                AND username LIKE CONCAT('%', #{pageQuery.username}, '%')
            </if>
            <if test="pageQuery.gender != null and pageQuery.gender != ''">
                AND gender = #{pageQuery.gender}
            </if>
        </where>
    </select>

    <update id="recordLoginSuccess">
        UPDATE
        <include refid="TableName"/>
        SET login_ip = #{loginIp},
        login_date = #{loginTime}
        WHERE id = #{userId}

    </update>

    <select id="queryDetailList" resultMap="UserDetailResultMap">
        SELECT
        <include refid="QueryAllColumns"/>,
        up.organization_id,
        up.order_in_organization,
        up.position_name,
        up.is_main
        FROM tenant_has_user tu
        LEFT JOIN <include refid="TableName"/>  u ON u.id = tu.user_id
        LEFT JOIN user_positions up ON u.id = up.user_id
        <where>
            up.organization_id = #{pageQuery.organizationId}
            <if test="pageQuery.username != null and pageQuery.username != ''">
                AND username LIKE CONCAT('%', #{pageQuery.username}, '%')
            </if>
            <if test="pageQuery.gender != null and pageQuery.gender != ''">
                AND gender = #{pageQuery.gender}
            </if>
        </where>
        ORDER BY up.order_in_organization
    </select>

    <select id="queryDetailById" resultMap="UserDetailResultMap">
        SELECT
        <include refid="QueryAllColumns"/>,
        up.organization_id,
        up.order_in_organization,
        up.position_name,
        up.is_main
        FROM tenant_has_user tu
        LEFT JOIN <include refid="TableName"/>  u ON u.id = tu.user_id
        LEFT JOIN user_positions up ON u.id = up.user_id
        WHERE u.id = #{id}
    </select>
</mapper>
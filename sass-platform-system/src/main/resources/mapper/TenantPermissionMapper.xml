<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fuhouyu.sass.platform.system.mapper.TenantPermissionMapper">
    <resultMap id="BaseResultMap" type="com.fuhouyu.sass.platform.system.entity.TenantPermission" extends="com.fuhouyu.sass.platform.system.mapper.BaseMapper.BaseResultMap">
        <result column="tenant_id" property="tenantId" jdbcType="VARCHAR"/>
        <result column="permission_id" property="permissionId" jdbcType="VARCHAR"/>
        <result column="create_at" property="createAt" jdbcType="TIMESTAMP"/>
        <result column="create_by" property="createBy" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="TableName">
        tenant_has_permission
    </sql>

    <sql id="AllColumns">
        tenant_id,
        permission_id,
        create_at,
        create_by
    </sql>

    <insert id="insertBatch" parameterType="com.fuhouyu.sass.platform.system.entity.Users">
        INSERT INTO
        <include refid="TableName"/>
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <include refid="AllColumns"/>
        </trim>
        VALUES
        <foreach collection="tenantPermissions" separator="," item="entity">
        <trim prefix="(" suffix=")" suffixOverrides=",">
            #{entity.tenantId},
            #{entity.permissionId},
            #{entity.createAt},
            #{entity.createBy},
        </trim>
        </foreach>
    </insert>

    <delete id="delete">
        DELETE FROM
        <include refid="TableName">
        </include>
        WHERE tenant_id = #{tenantId}
        <if test="permissionIds != null and permissionIds.size() > 0">
            AND permission_id IN
            <foreach collection="permissionIds" open="(" close=")" item="permissionId" separator=",">
                #{permissionId}
            </foreach>
        </if>
    </delete>

    <delete id="deleteTenantPermissions">
        DELETE
            FROM
        <include refid="TableName">
        </include>
        WHERE tenant_id IN
        <foreach collection="configIds" open="(" close=")" separator="," item="configId">
            #{configId}
        </foreach>
    </delete>

    <select id="queryPermissionIdByTenantId" resultType="java.lang.Long">
        SELECT permission_id
        FROM tenant_has_permission
        WHERE tenant_id = #{configId}
    </select>
</mapper>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fuhouyu.sass.platform.system.mapper.PermissionMapper">
    <resultMap id="BaseResultMap" type="com.fuhouyu.sass.platform.system.entity.Permissions" extends="com.fuhouyu.sass.platform.system.mapper.BaseMapper.BaseResultMap">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="parent_id" property="parentId" jdbcType="BIGINT"/>
        <result column="permission_name" property="permissionName" jdbcType="VARCHAR"/>
        <result column="permission_code" property="permissionCode" jdbcType="VARCHAR"/>
        <result column="permission_type" property="permissionType" jdbcType="VARCHAR"/>
        <result column="display_order" property="displayOrder" jdbcType="INTEGER"/>
        <result column="icon" property="icon" jdbcType="VARCHAR"/>
        <result column="route_path" property="routePath" jdbcType="VARCHAR"/>
        <result column="component_path" property="componentPath" jdbcType="VARCHAR"/>
        <result column="url_params" property="urlParams" jdbcType="VARCHAR"/>
        <result column="is_frame" property="isFrame" jdbcType="BOOLEAN"/>
        <result column="is_allow_modified" property="isAllowModified" jdbcType="BOOLEAN"/>
        <result column="is_visible" property="isVisible" jdbcType="BOOLEAN"/>
        <result column="is_leaf" property="isLeaf" jdbcType="BOOLEAN"/>
        <result column="is_enabled" property="isEnabled" jdbcType="BOOLEAN"/>
        <result column="owner_tenant_id" property="ownerTenantId" jdbcType="BOOLEAN"/>
    </resultMap>

    <sql id="TableName">
        permissions
    </sql>

    <sql id="AllColumns">
        id,
        parent_id,
        permission_name,
        permission_code,
        permission_type,
        display_order,
        icon,
        route_path,
        component_path,
        url_params,
        is_frame,
        is_allow_modified,
        is_visible,
        is_leaf,
        is_enabled,
        owner_tenant_id,
        is_deleted,
        create_at,
        update_at,
        create_by,
        update_by
    </sql>

    <sql id="QueryColumns">
        p.id,
        p.parent_id,
        p.permission_name,
        p.permission_code,
        p.permission_type,
        p.display_order,
        p.icon,
        p.route_path,
        p.component_path,
        p.url_params,
        p.is_frame,
        p.is_allow_modified,
        p.is_visible,
        p.is_leaf,
        p.is_enabled,
        p.owner_tenant_id,
        p.is_deleted,
        p.create_at,
        p.update_at,
        p.create_by,
        p.update_by
    </sql>

    <insert id="insert" parameterType="com.fuhouyu.sass.platform.system.entity.Permissions">
        INSERT INTO
        <include refid="TableName"/>
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <include refid="AllColumns"/>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            #{id},
            #{parentId},
            #{permissionName},
            #{permissionCode},
            #{permissionType},
            #{displayOrder},
            #{icon},
            #{routePath},
            #{componentPath},
            #{urlParams},
            #{isFrame},
            #{isAllowModified},
            #{isVisible},
            #{isLeaf},
            #{isEnabled},
            #{ownerTenantId},
            #{isDeleted},
            #{createAt},
            #{updateAt},
            #{createBy},
            #{updateBy},
        </trim>
    </insert>

    <insert id="insertBatch" parameterType="java.util.List" >
        INSERT INTO
        <include refid="TableName"/>
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <include refid="AllColumns"/>
        </trim>
        VALUES
        <foreach collection="list" separator="," item="entity">
            <trim prefix="(" suffix=")" suffixOverrides=",">
                #{entity.id},
                #{entity.parentId},
                #{entity.permissionName},
                #{entity.permissionCode},
                #{entity.permissionType},
                #{entity.displayOrder},
                #{entity.icon},
                #{entity.routePath},
                #{entity.componentPath},
                #{entity.urlParams},
                #{entity.isFrame},
                #{entity.isAllowModified},
                #{entity.isVisible},
                #{entity.isLeaf},
                #{entity.isEnabled},
                #{entity.ownerTenantId},
                #{entity.isDeleted},
                #{entity.createAt},
                #{entity.updateAt},
                #{entity.createBy},
                #{entity.updateBy},
            </trim>
        </foreach>
    </insert>

    <update id="update" parameterType="com.fuhouyu.sass.platform.system.entity.Permissions">
        UPDATE
        <include refid="TableName"/>
        SET

        <if test="permissionName != null and permissionName != ''">
            permission_name = #{permissionName},
        </if>
        <if test="displayOrder != null ">
            display_order = #{displayOrder},
        </if>
        <if test="icon != null">
            icon = #{icon},
        </if>
        <if test="routePath != null">
            route_path = #{routePath},
        </if>
        <if test="componentPath != null">
            component_path = #{componentPath},
        </if>
        <if test="urlParams != null and urlParams != ''">
            url_params = #{urlParams},
        </if>
        <if test="isFrame != null">
            is_frame = #{isFrame},
        </if>
         <if test="isVisible != null">
            is_visible = #{isVisible},
        </if>
        <if test="isLeaf != null">
            is_leaf = #{isLeaf},
        </if>
        <if test="isEnabled != null">
            is_enabled = #{isEnabled},
        </if>
        update_at = #{updateAt},
        update_by = #{updateBy}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM <include refid="TableName"/>
        WHERE id = #{id}
    </delete>

    <delete id="deleteByIds" parameterType="java.util.List">
        DELETE FROM <include refid="TableName"/>
        WHERE id IN
        <foreach collection="list" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
    </delete>

    <select id="queryById" resultMap="BaseResultMap">
        SELECT <include refid="AllColumns"/>
        FROM <include refid="TableName"/> p
        WHERE id = #{id}
        AND p.is_deleted = false
    </select>


    <select id="queryByIds" parameterType="java.util.List" resultMap="BaseResultMap">
        SELECT <include refid="QueryColumns"/>
        FROM <include refid="TableName"/> p
        WHERE p.id IN
        <foreach collection="list" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
        AND p.is_deleted = false
        ORDER BY display_order
    </select>


    <select id="queryByPermissionCode" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT <include refid="QueryColumns"/>
        FROM <include refid="TableName"/> p
        WHERE p.permission_code = #{permissionCode}
    </select>

    <select id="queryList" resultMap="BaseResultMap" >
        SELECT
        <include refid="QueryColumns"/>
                FROM
        <include refid="TableName"/> p
        <where>
            <if test="pageQuery.parentId != null">
                p.parent_id = #{pageQuery.parentId}
            </if>
            <if test="pageQuery.permissionName != null and pageQuery.permissionName != ''">
                AND p.permission_name LIKE CONCAT('%',#{pageQuery.permissionName},'%')
            </if>
            AND p.is_deleted = false
        </where>
    </select>

    <select id="queryListByRoleIdList" resultMap="BaseResultMap">
        SELECT
        <include refid="QueryColumns"/>
        FROM
        role_has_permission rhp
        LEFT JOIN <include refid="TableName"/> p ON p.id = rhp.permission_id
        WHERE
        <foreach collection="roleIdList" separator="," item="roleId" open="rhp.role_id IN (" close=")">
            #{roleId}
        </foreach>
        AND p.is_deleted = false
    </select>

    <select id="queryUserPermissonList" resultMap="BaseResultMap">

        SELECT
        <include refid="QueryColumns"/>
        FROM
        user_has_role uhr
        LEFT JOIN role_has_permission uhp ON uhr.role_id = uhp.role_id
        LEFT JOIN roles r ON r.id = uhp.role_id
        LEFT JOIN <include refid="TableName"/> p ON p.id = uhp.permission_id AND p.is_deleted = false
        WHERE
        uhr.user_id = #{userId}
        ORDER BY p.display_order
    </select>

    <select id="queryListByParentId" resultMap="BaseResultMap">
        SELECT
        <include refid="QueryColumns"/>
        FROM
        <include refid="TableName"/> p
        WHERE parent_id = #{parentId}
        AND is_deleted = false
        ORDER BY display_order
    </select>

    <update id="updateLeafById">
        UPDATE
        <include refid="TableName"/>
        SET is_leaf = #{isLeaf}
        WHERE id = #{id}
    </update>

    <update id="setLeafByIdList">
        UPDATE <include refid="TableName"/>
     AS parent
        SET is_leaf = CASE
                          WHEN NOT EXISTS (
                              SELECT 1
                              FROM <include refid="TableName"/> AS child
                              WHERE child.parent_id = parent.id
                          ) THEN TRUE
                          ELSE FALSE
            END
        WHERE parent.id IN
            <foreach collection="parentIdList" item="id" separator="," open="(" close=")">
                #{id}
            </foreach>
    </update>

    <select id="queryUserPermissionCodeList" resultType="java.lang.String">
        SELECT p.permission_code

        FROM
        user_has_role uhr
        LEFT JOIN roles r ON uhr.role_id = r.id
        LEFT JOIN role_has_permission uhp ON uhr.role_id = uhp.role_id
        LEFT JOIN
        <include refid="TableName"/>
        p ON p.id = uhp.permission_id
        WHERE
        r.owner_tenant_id = #{tenantId}
        AND uhr.user_id = #{userId}
        AND r.is_deleted = false
        AND p.is_deleted = false
    </select>

    <delete id="deleteByTenantIds">
        DELETE FROM
        <include refid="TableName"/>
        WHERE owner_tenant_id IN
        <foreach collection="tenantIds" separator="," open="(" close=")" item="tenantId">
            #{tenantId}
        </foreach>
    </delete>

    <select id="queryAttachTenantPermissionListByParentId" resultMap="BaseResultMap">
        SELECT
        <include refid="QueryColumns"/>
        FROM
        tenant_has_permission thp
        LEFT JOIN <include refid="TableName"/> p ON p.id = thp.permission_id
        WHERE parent_id = #{parentId}
        AND is_deleted = false
        ORDER BY display_order
    </select>

    <select id="queryAll" resultMap="BaseResultMap">
        SELECT
        <include refid="QueryColumns"/>
        FROM
        <include refid="TableName"/> p
        WHERE is_deleted = false
    </select>
</mapper>
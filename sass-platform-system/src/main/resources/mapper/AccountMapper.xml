<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fuhouyu.sass.platform.system.mapper.AccountMapper">
    <resultMap id="BaseResultMap" type="com.fuhouyu.sass.platform.system.domain.entity.Accounts" extends="com.fuhouyu.sass.platform.system.mapper.BaseMapper.BaseResultMap">
        <id column="account" property="account" jdbcType="VARCHAR"/>
        <result column="account_type" property="accountType" jdbcType="VARCHAR"/>
        <result column="user_type" property="userType" jdbcType="VARCHAR"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="credentials" property="credentials" jdbcType="VARCHAR"/>
        <result column="credentials_expiration_time" property="credentialsExpirationTime" jdbcType="TIMESTAMP"/>
        <result column="ref_account_id" property="refAccountId" jdbcType="VARCHAR"/>
        <result column="is_enabled" property="isEnabled" jdbcType="BOOLEAN"/>
        <result column="owner_tenant_id" property="ownerTenantId" jdbcType="BIGINT"/>
    </resultMap>

    <sql id="TableName">
        accounts
    </sql>

    <sql id="AllColumns">
        account,
        account_type,
        user_type,
        user_id,
        credentials,
        credentials_expiration_time,
        ref_account_id,
        owner_tenant_id,
        is_enabled,
        created_at,
        updated_at,
        created_by,
        updated_by
    </sql>

    <insert id="insert" parameterType="com.fuhouyu.sass.platform.system.domain.entity.Accounts">
        INSERT INTO
        <include refid="TableName"/>
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <include refid="AllColumns"/>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            #{account},
            #{accountType},
            #{userType},
            #{userId},
            #{credentials},
            #{credentialsExpirationTime},
            #{refAccountId},
            #{ownerTenantId},
            #{isEnabled},
            #{createdAt},
            #{updatedAt},
            #{createdBy},
            #{updatedBy}
        </trim>
    </insert>

    <insert id="insertBatch" parameterType="java.util.List" >
        INSERT INTO
        <include refid="TableName"/>
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <include refid="AllColumns"/>
        </trim>
        VALUES
        <foreach collection="list" separator="," item="entity">
            <trim prefix="(" suffix=")" suffixOverrides=",">
                #{entity.account},
                #{entity.accountType},
                #{entity.userType},
                #{entity.userId},
                #{entity.credentials},
                #{entity.credentialsExpirationTime},
                #{entity.refAccountId},
                #{entity.ownerTenantId},
                #{entity.isEnabled},
                #{entity.createdAt},
                #{entity.updatedAt},
                #{entity.createdBy},
                #{entity.updatedBy}
            </trim>
        </foreach>
    </insert>

    <update id="update" parameterType="com.fuhouyu.sass.platform.system.domain.entity.Accounts">
        UPDATE
        <include refid="TableName"/>
        SET
        <if test="credentials != null and credentials != ''">
            credentials = #{credentials},
        </if>
        <if test="credentialsExpirationTime != null">
            credentials_expiration_time = #{credentialsExpirationTime},
        </if>
        <if test="refAccountId != null and refAccountId != ''">
            ref_account_id = #{refAccountId},
        </if>
        updated_at = #{updatedAt},
        updated_by = #{updatedBy}
        WHERE account = #{account}
        AND account_type = #{accountType}
    </update>

    <delete id="deleteById">
        DELETE FROM <include refid="TableName"/>
        WHERE account = #{account}
        AND account_type = #{accountType}

    </delete>

    <delete id="deleteByIds" parameterType="java.util.List">
        DELETE FROM
        <include refid="TableName"/>
        WHERE
        <foreach collection="list" item="item" separator=" AND ">
            (account = #{item.account} AND account_type = #{item.account_type})
        </foreach>
    </delete>

    <select id="queryById" resultMap="BaseResultMap">
        SELECT <include refid="AllColumns"/>
        FROM <include refid="TableName"/>
        WHERE account = #{account}
        AND account_type = #{accountType}
        AND owner_tenant_id = #{tenantId}
    </select>


    <select id="queryByIds" parameterType="java.util.List" resultMap="BaseResultMap">
        SELECT <include refid="AllColumns"/>
        FROM <include refid="TableName"/>
        WHERE
         <foreach collection="list" item="item" separator=" AND ">
            (account = #{item.account} AND account_type = #{item.account_type})
        </foreach>
    </select>

    <select id="queryList" resultMap="BaseResultMap" >
        SELECT
        <include refid="AllColumns"/>
                FROM
        <include refid="TableName"/>
    </select>

    <select id="queryByUserId" resultMap="BaseResultMap">
        SELECT
        <include refid="AllColumns"/>
                FROM
        <include refid="TableName"/>
        WHERE user_id = #{userId}
    </select>

    <delete id="deleteByUserIds">
        DELETE FROM
        <include refid="TableName"/>
        WHERE  user_id in
        <foreach collection="userIds" item="userId" separator="," open="(" close=")">
            #{userId}
        </foreach>
    </delete>

    <select id="queryAccountListForMe" resultMap="BaseResultMap">
        SELECT
        <include refid="AllColumns"/>
        FROM
        <include refid="TableName"/>
        WHERE user_id = #{userId}
    </select>

    <select id="queryAccountByUserIdAndType" resultMap="BaseResultMap">
        SELECT
        <include refid="AllColumns"/>
        FROM
        <include refid="TableName"/>
        WHERE user_id = #{userId}
        AND account_type = #{accountType}
    </select>

    <delete id="deleteByTenantIds">
        DELETE FROM <include refid="TableName"/>   a
        WHERE a.owner_tenant_id IN
        <foreach collection="tenantIds" open="(" close=")" separator="," item="tenantId">
            #{tenantId}
        </foreach>
    </delete>
</mapper>
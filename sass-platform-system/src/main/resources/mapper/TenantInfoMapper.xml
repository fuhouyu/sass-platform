<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fuhouyu.sass.platform.system.mapper.TenantInfoMapper">
    <resultMap id="BaseResultMap" type="com.fuhouyu.sass.platform.system.entity.TenantInfo" extends="com.fuhouyu.sass.platform.system.mapper.BaseMapper.BaseResultMap">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="admin_user_id" property="adminUserId" jdbcType="BIGINT"/>
        <result column="tenant_code" property="tenantCode" jdbcType="VARCHAR"/>
        <result column="tenant_name" property="tenantName" jdbcType="VARCHAR"/>
        <result column="tenant_type" property="tenantType" jdbcType="VARCHAR"/>
        <result column="remark" property="remark" jdbcType="VARCHAR"/>
        <result column="icon" property="icon" jdbcType="VARCHAR"/>
        <result column="contact_person" property="contactPerson" jdbcType="VARCHAR"/>
        <result column="contact_info" property="contactInfo" jdbcType="VARCHAR"/>
        <result column="is_enabled" property="isEnabled" jdbcType="BOOLEAN"/>
        <result column="start_date" property="startDate" jdbcType="DATE"/>
        <result column="end_date" property="endDate" jdbcType="DATE"/>
    </resultMap>

    <resultMap id="BaseDetailResult" type="com.fuhouyu.sass.platform.system.dto.tenant.TenantInfoDetailDTO" extends="BaseResultMap">
        <result column="real_name" property="adminUserRealName"/>
    </resultMap>

    <sql id="TableName">
        tenant_info
    </sql>

    <sql id="QueryColumns">
        ti.id,
        ti.admin_user_id,
        ti.tenant_code,
        ti.tenant_name,
        ti.tenant_type,
        ti.remark,
        ti.icon,
        ti.contact_person,
        ti.contact_info,
        ti.is_enabled,
        ti.start_date,
        ti.end_date,
        ti.created_at,
        ti.updated_at,
        ti.created_by,
        ti.updated_by
    </sql>

    <sql id="AllColumns">
        id,
        admin_user_id,
        tenant_code,
        tenant_name,
        tenant_type,
        remark,
        icon,
        contact_person,
        contact_info,
        is_enabled,
        start_date,
        end_date,
        is_deleted,
        created_at,
        updated_at,
        created_by,
        updated_by
    </sql>

    <insert id="insert" parameterType="com.fuhouyu.sass.platform.system.entity.TenantInfo">
        INSERT INTO
        <include refid="TableName"/>
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <include refid="AllColumns"/>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            #{id},
            #{adminUserId},
            #{tenantCode},
            #{tenantName},
            #{tenantType},
            #{remark},
            #{icon},
            #{contactPerson},
            #{contactInfo},
            #{isEnabled},
            #{startDate},
            #{endDate},
            #{isDeleted},
            #{createdAt},
            #{updatedAt},
            #{createdBy},
            #{updatedBy}
        </trim>
    </insert>

    <insert id="insertBatch" parameterType="java.util.List" >
        INSERT INTO
        <include refid="TableName"/>
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <include refid="AllColumns"/>
        </trim>
        VALUES
        <foreach collection="list" separator="," item="entity">
            <trim prefix="(" suffix=")" suffixOverrides=",">
                #{entity.id},
                #{entity.adminUserId},
                #{entity.tenantCode},
                #{entity.tenantName},
                #{entity.tenantType},
                #{entity.remark},
                #{entity.icon},
                #{entity.contactPerson},
                #{entity.contactInfo},
                #{entity.isEnabled},
                #{entity.startDate},
                #{entity.endDate},
                #{entity.isDeleted},
                #{entity.createdAt},
                #{entity.updatedAt},
                #{entity.createdBy},
                #{entity.updatedBy},
            </trim>
        </foreach>
    </insert>

    <update id="update" parameterType="com.fuhouyu.sass.platform.system.entity.TenantInfo">
        UPDATE
        <include refid="TableName"/>
        SET
        <if test="tenantName != null and tenantName != ''">
            tenant_name = #{tenantName},
        </if>
        <if test="contactPerson != null and contactPerson != ''">
            contact_person = #{contactPerson},
        </if>
        <if test="contactInfo != null and contactInfo != ''">
            contact_info = #{contactInfo},
        </if>
        <if test="isEnabled != null">
            is_enabled = #{isEnabled},
        </if>
        start_date = #{startDate},
        end_date = #{endDate},
        remark = #{remark},
        updated_at = #{updatedAt},
        updated_by = #{updatedBy}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM <include refid="TableName"/>
        WHERE id = #{id}
    </delete>

    <delete id="deleteByIds" parameterType="java.util.List">
        DELETE FROM <include refid="TableName"/>
        WHERE id IN
        <foreach collection="list" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
    </delete>

    <select id="queryById" resultMap="BaseResultMap">
        SELECT <include refid="QueryColumns"/>
        FROM <include refid="TableName"/> ti
        WHERE ti.id = #{id}
    </select>


    <select id="queryByIds" parameterType="java.util.List" resultMap="BaseResultMap">
        SELECT <include refid="QueryColumns"/>
        FROM <include refid="TableName"/> ti
        WHERE ti.id IN
        <foreach collection="list" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
    </select>


    <select id="queryByTenantCode" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT <include refid="QueryColumns"/>
        FROM <include refid="TableName"/> ti
        WHERE ti.tenant_code = #{tenantCode}
    </select>

    <select id="queryList" resultMap="BaseResultMap" >
        SELECT
        <include refid="QueryColumns"/>
                FROM
        <include refid="TableName"/> ti
        <where>
            <if test="pageQuery.tenantName != null and pageQuery.tenantName != ''">
                ti.tenant_name LIKE CONCAT('%', #{pageQuery.tenantName}, '%')
            </if>
        </where>
    </select>

    <select id="queryByUserId" resultMap="BaseResultMap">
        SELECT
        <include refid="QueryColumns"/>
        FROM  tenant_has_user thu
        LEFT JOIN <include refid="TableName"/> ti ON ti.id = thu.tenant_id
        WHERE thu.user_id = #{userId}

    </select>

    <select id="existsUserTenant" resultType="java.lang.Integer">
        SELECT COUNT(1)
        FROM tenant_has_user thu
        LEFT JOIN
        <include refid="TableName"/>
        ti ON ti.id = thu.tenant_id
        WHERE thu.user_id = #{userId}
        AND ti.id = #{tenantId}
    </select>

    <select id="queryDetailById" resultMap="BaseDetailResult">
        SELECT
        <include refid="QueryColumns"/>,
        u.real_name
        FROM
        <include refid="TableName"/> ti
        LEFT JOIN users u ON ti.admin_user_id = u.id
        WHERE ti.id = #{id}
    </select>
</mapper>
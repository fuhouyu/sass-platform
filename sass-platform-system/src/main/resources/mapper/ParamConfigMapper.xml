<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fuhouyu.sass.platform.system.mapper.ParamConfigMapper">
    <resultMap id="BaseResultMap" type="com.fuhouyu.sass.platform.system.domain.entity.ParamConfigs" extends="com.fuhouyu.sass.platform.system.mapper.BaseMapper.BaseResultMap">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="config_name" property="configName"/>
        <result column="config_key" property="configKey"/>
        <result column="config_value" property="configValue"/>
        <result column="group_key" property="groupKey"/>
        <result column="remark" property="remark"/>
        <result column="is_allow_modified" property="isAllowModified"/>
    </resultMap>


    <sql id="TableName">
        param_configs
    </sql>

    <sql id="InsertColumns">
        id,
       config_name,
        config_key,
        config_value,
        group_key,
        remark,
        is_allow_modified,
        created_at,
        created_by,
        updated_at,
        updated_by
    </sql>

    <sql id="QueryAllColumns">
        pc.id,
        pc.config_name,
        pc.config_key,
        pc.config_value,
        pc.group_key,
        pc.remark,
        pc.is_allow_modified,
        pc.created_at,
        pc.created_by,
        pc.updated_at,
        pc.updated_by
    </sql>

    <insert id="insert" parameterType="com.fuhouyu.sass.platform.system.domain.entity.ParamConfigs">
        INSERT INTO
        <include refid="TableName"/>
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <include refid="InsertColumns"/>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            #{id},
            #{configName},
            #{configKey},
            #{configValue},
            #{groupKey},
            #{remark},
            #{isAllowModified},
            #{createdAt},
            #{createdBy},
            #{updatedAt},
            #{updatedBy}
        </trim>
    </insert>

    <insert id="insertBatch" parameterType="java.util.List" >
        INSERT INTO
        <include refid="TableName"/>
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <include refid="InsertColumns"/>
        </trim>
        VALUES
        <foreach collection="list" separator="," item="entity">
            <trim prefix="(" suffix=")" suffixOverrides=",">
                #{entity.id},
                #{entity.configName},
                #{entity.configKey},
                #{entity.configValue},
                #{entity.groupKey},
                #{entity.remark},
                #{entity.isAllowModified},
                #{entity.createdAt},
                #{entity.createdBy},
                #{entity.updatedAt},
                #{entity.updatedBy}
            </trim>
        </foreach>
    </insert>

    <update id="update" parameterType="com.fuhouyu.sass.platform.system.domain.entity.ParamConfigs">
        UPDATE
        <include refid="TableName"/>
        SET
        <if test="configName != null and configName != ''">
            config_name = #{configName},
        </if>
        <if test="configValue != null and configValue != ''">
            config_value = #{configValue},
        </if>
        <if test="groupKey != null and groupKey != ''">
            group_key = #{groupKey},
        </if>
        <if test="remark != null and remark != ''">
            remark = #{remark},
        </if>
        updated_at = #{updatedAt},
        updated_by = #{updatedBy}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM <include refid="TableName"/>
        WHERE id = #{id}
    </delete>

    <delete id="deleteByIds" parameterType="java.util.List">
        DELETE FROM <include refid="TableName"/>
        WHERE id IN
        <foreach collection="list" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
    </delete>

    <select id="queryById" resultMap="BaseResultMap">
        SELECT <include refid="QueryAllColumns"/>
        FROM <include refid="TableName"/> pc
        WHERE pc.id = #{id}
    </select>


    <select id="queryByIds" parameterType="java.util.List" resultMap="BaseResultMap">
        SELECT <include refid="QueryAllColumns"/>
        FROM <include refid="TableName"/> pc
        WHERE pc.id IN
        <foreach collection="list" open="(" close=")" separator="," item="id">
            #{id}
        </foreach>
    </select>

    <select id="queryList" resultMap="BaseResultMap" >
        SELECT
        <include refid="QueryAllColumns"/>
        FROM
        <include refid="TableName"/> pc
        <where>
            <if test="pageQuery.configName != null and pageQuery.configName != ''">
                pc.config_name LIKE CONCAT('%', #{pageQuery.configName}, '%')
            </if>
            <if test="pageQuery.configKey != null and pageQuery.configKey != ''">
                AND pc.config_key LIKE CONCAT('%', #{pageQuery.configKey}, '%')
            </if>
        </where>
    </select>

    <select id="queryByConfigKey" resultMap="BaseResultMap">
        SELECT
        <include refid="QueryAllColumns"/>
        FROM
        <include refid="TableName"/> pc
        WHERE pc.config_key = #{configKey}
    </select>

    <select id="queryByGroupKey" resultMap="BaseResultMap">
        SELECT
        <include refid="QueryAllColumns"/>
        FROM
        <include refid="TableName"/> pc
        WHERE pc.group_key = #{groupKey}
    </select>
</mapper>
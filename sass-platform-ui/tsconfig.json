{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
  ],
  "compilerOptions": {
    "baseUrl": "./",
    "removeComments": true,
    // 删除注释
    "preserveConstEnums": true,
    // 保留 const 和 enum 声明
    "sourceMap": true,
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@components/*": [
        "src/components/*"
      ]
    },
    "types": [
      "vite/client"
    ],
    "jsx": "react"
  }
}

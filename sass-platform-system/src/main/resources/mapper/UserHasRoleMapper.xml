<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fuhouyu.sass.platform.system.mapper.UserHasRoleMapper">
    <resultMap id="BaseResultMap" type="com.fuhouyu.sass.platform.system.domain.entity.UserHasRole" extends="com.fuhouyu.sass.platform.system.mapper.BaseMapper.BaseResultMap">
        <result column="role_id" property="roleId" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
    </resultMap>


    <sql id="TableName">
        user_has_role
    </sql>

    <sql id="InsertColumn">
        role_id,
        user_id,
        created_at,
        created_by
    </sql>

    <insert id="insert" parameterType="com.fuhouyu.sass.platform.system.domain.entity.AdminUsers">
        INSERT INTO
        <include refid="TableName"/>
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <include refid="InsertColumn"/>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            #{roleId},
            #{userId},
            #{createdAt},
            #{createdBy},
        </trim>
        ON CONFLICT(user_id, role_id) DO NOTHING
    </insert>

    <insert id="insertBatch" parameterType="java.util.List" >
        INSERT INTO
        <include refid="TableName"/>
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <include refid="InsertColumn"/>
        </trim>
        VALUES
        <foreach collection="list" separator="," item="entity">
            <trim prefix="(" suffix=")" suffixOverrides=",">
                #{entity.roleId},
                #{entity.userId},
                #{entity.createdAt},
                #{entity.createdBy},
            </trim>
        </foreach>
        ON CONFLICT(user_id, role_id) DO NOTHING
    </insert>

    <delete id="deleteByUserIds">
        DELETE FROM
        <include refid="TableName"/>
        WHERE user_id IN
        <foreach collection="userIds" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </delete>

    <select id="queryRoleIdsByUserId" resultType="java.lang.Long">
        SELECT r.id FROM
        <include refid="TableName"/> uhr
        LEFT JOIN roles r   ON r.id = uhr.role_id
        WHERE user_id = #{userId}
    </select>
</mapper>
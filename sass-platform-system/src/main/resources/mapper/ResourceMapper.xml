<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fuhouyu.sass.platform.system.mapper.ResourceMapper">
    <resultMap id="BaseResultMap" type="com.fuhouyu.sass.platform.system.domain.entity.Resources" extends="com.fuhouyu.sass.platform.system.mapper.BaseEntityMapper.BaseResultMap">
        <id column="id" property="id"/>
        <result column="parent_id" property="parentId"/>
        <result column="name" property="name"/>
        <result column="size" property="size"/>
        <result column="mime_type" property="mimeType"/>
        <result column="etag" property="etag"/>
        <result column="object_key" property="objectKey"/>
        <result column="version" property="version"/>
        <result column="category" property="category"/>
        <result column="is_public" property="isPublic"/>
        <result column="is_directory" property="isDirectory"/>
        <result column="is_tmp_file" property="isTmpFile"/>
        <result column="owner_tenant_id" property="ownerTenantId"/>
    </resultMap>

    <resultMap id="ResourceDetail" type="com.fuhouyu.sass.platform.system.domain.dto.resource.ResourceDetailDTO" extends="BaseResultMap">
        <result property="bucketName" column="bucket_name"/>
    </resultMap>

    <sql id="TableName">
        resources
    </sql>

    <sql id="InsertColumns">
        id,
        parent_id,
        name,
        size,
        mime_type,
        object_key,
        etag,
        version,
        category,
        is_deleted,
        is_public,
        is_directory,
        is_tmp_file,
        owner_tenant_id,
        created_at,
        updated_at,
        created_by,
        updated_by
    </sql>


    <sql id="QueryColumns">
        r.id,
        r.parent_id,
        r.name,
        r.size,
        r.category,
        r.mime_type,
        r.object_key,
        r.etag,
        r.version,
        r.is_public,
        r.is_directory,
        r.is_tmp_file,
        r.owner_tenant_id,
        r.created_at,
        r.updated_at,
        r.created_by,
        r.updated_by
    </sql>

    <insert id="insert" parameterType="com.fuhouyu.sass.platform.system.domain.entity.Resources">
        INSERT INTO
        <include refid="TableName"/>
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <include refid="InsertColumns"/>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            #{id},
            #{parentId},
            #{name},
            #{size},
            #{mimeType},
            #{objectKey},
            #{etag},
            #{version},
            #{category},
            #{isDeleted},
            #{isPublic},
            #{isDirectory},
            #{isTmpFile},
            #{ownerTenantId},
            #{createdAt},
            #{updatedAt},
            #{createdBy},
            #{updatedBy}
        </trim>
    </insert>


    <select id="queryList" resultMap="BaseResultMap" >
        SELECT
        <include refid="QueryColumns"/>
                FROM
        <include refid="TableName"/> r
        <where>
            <if test="pageQuery.prefix != null and pageQuery.prefix != ''">
                r.parent_id = (SELECT id FROM <include refid="TableName"/> WHERE CONCAT(object_key, '/') = #{pageQuery.prefix})
            </if>
            <if test="pageQuery.prefix == null or pageQuery.prefix == ''">
              AND r.parent_id = -1
            </if>
            <if test="pageQuery.name != null and pageQuery.name != ''">
               AND r.name LIKE CONCAT('%',#{pageQuery.name}, '%')
            </if>
            <if test="pageQuery.category != null and pageQuery.category != ''">
                AND r.category = #{pageQuery.category}
            </if>
            <if test="pageQuery.isPublic != null">
                AND r.is_public = #{pageQuery.isPublic}
            </if>
        </where>
    </select>

    <select id="queryByEtag" resultMap="BaseResultMap">
        SELECT
        <include refid="QueryColumns"/>
        FROM
        <include refid="TableName"/> r
        WHERE r.etag = #{etag}
    </select>

    <select id="queryByObjectKey" resultMap="BaseResultMap">
        SELECT
        <include refid="QueryColumns"/>
        FROM
        <include refid="TableName"/> r
        WHERE r.object_key = #{objectKey}
    </select>

    <select id="queryByPrefixList" resultMap="BaseResultMap">
        SELECT
        DISTINCT
        <include refid="QueryColumns"/>
        FROM
        <include refid="TableName"/> r
        WHERE
        <foreach collection="prefixList" item="prefix" separator=" OR " >
            r.object_key  LIKE CONCAT(#{prefix}, '%')
        </foreach>
    </select>

    <select id="countObjects" resultType="java.lang.Integer">
        SELECT
        COUNT(1)
        FROM
        <include refid="TableName"/> r
        WHERE r.is_directory = false
    </select>

    <select id="queryDetailById" resultMap="ResourceDetail">
        SELECT
        <include refid="QueryColumns"/>,
        ts.bucket_name
        FROM
        <include refid="TableName"/> r
        LEFT JOIN tenant_space ts ON r.owner_tenant_id = ts.tenant_id
        WHERE r.id = #{id}
    </select>
</mapper>